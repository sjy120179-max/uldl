      "Bash(cmd.exe /c \"taskkill /F /PID 14340 & taskkill /F /PID 39400\")",
      "Bash(powershell.exe -Command \"Stop-Process -Id 14340 -Force; Stop-Process -Id 39400 -Force\")"
